{
  "name": "dsh-session-resume",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "type": "module",
  "description": "DSH plugin: an interrupted (restart-torn) session shows a 'continue' button; clicking it resumes the turn without the user typing a message.",
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p packages/session-resume/tsconfig.json && cd packages/session-resume && tsdown --env.DSH_BUILD_FACE=host",
    "build:client": "tsc -p packages/session-resume/tsconfig.client.json && cd packages/session-resume && tsdown --env.DSH_BUILD_FACE=client",
    "test": "vitest run"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "lightningcss": "^1.29.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vite-tsconfig-paths": "^5.1.4",
    "vite": "^7.0.0",
    "clsx": "2.1.1",
    "simple-icons": "16.31.0",
    "diff": "9.0.0",
    "@deepseek-ai/dsh-util-code-language": "0.1.7-rc.2"
  }
}
